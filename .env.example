# false = datos y servicios simulados (Parte A). true = llama al backend de Azure (Parte B).
VITE_USE_AZURE=false
# URL base del backend de Azure Functions; en desarrollo se envía al proxy local.
VITE_API_BASE_URL=/api
# false = apaga el asistente de IA (interruptor de apagado).
VITE_ASSISTANT_ENABLED=true
